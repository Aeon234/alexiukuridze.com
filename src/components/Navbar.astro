---
import Button from "./Button.astro";
import MenuPanel from "./MenuPanel.astro";

const pages = [
  { href: "/", label: "Home", icon: "house" },
  { href: "/projects/", label: "Projects", icon: "folder-open" },
  { href: "/blog/", label: "Blog", icon: "pen-line" },
  { href: "/films-and-books/", label: "Films and Books", icon: "clapperboard" },
] as const;

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
const links = pages.map((page) => ({ ...page, current: isCurrent(page.href) }));
---

<header class="mx-auto flex max-w-page items-center gap-[4px] px-s-l py-s">
  <a href="/" class="mr-auto font-display text-step-1 font-medium">
    Alex Iukuridze
  </a>
  <nav aria-label="Main" class="flex max-md:hidden">
    {links.map((link) => (
      <Button
        kind="ghost"
        href={link.href}
        icon={link.icon}
        label={link.label}
        aria-current={link.current ? "page" : undefined}
      />
    ))}
  </nav>
  <Button
    kind="ghost"
    icon="menu"
    iconOnly
    label="Open Menu"
    aria-controls="menu"
    aria-expanded="false"
    aria-haspopup="dialog"
    class="md:hidden"
  />
  <MenuPanel links={links} />
</header>
